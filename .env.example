# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
# The domains and account IDs below are the current store example.
# Replace them for EACH separate store deployment; see REUSE-FOR-ANOTHER-STORE.txt.
APP_URL=https://checkout.nexool.shop
STOREFRONT_URL=https://nexool.shop
SHOPIFY_SHOP_DOMAIN=bfuwye-df.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WHOP_BUSINESS_ID=biz_huT0pZAGlTYetE
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Create a physical-goods product in Whop; this is its prod_ ID.
WHOP_PRODUCT_ID=
# Start with currencies confirmed for YOUR Whop account. Add more after testing.
WHOP_ENABLED_CURRENCIES=USD
# Neon pooled connection string. SSL is required in deployment.
DATABASE_URL=
# Generate two DIFFERENT random secrets, at least 32 characters each.
ADMIN_SECRET=
CRON_SECRET=
# Remain false until credentials, taxes, fees and a real test order are verified.
CHECKOUT_ENABLED=false
# Must be explicitly true after confirming Whop buyer fees are disabled and
# its tax treatment matches the Shopify totals for your business.
PAYMENT_SETTINGS_VERIFIED=false
WHOP_RECEIPT_TITLE=Store order
SUPPORT_EMAIL=
# Optional: forward one tracking number from Shopify to Whop. Multi-parcel needs review.
TRACKING_SYNC_ENABLED=false
# Optional. Enable Places API (New) and billing in Google Cloud.
# Server-side key; restrict it to Places API (New). Manual entry works without it.
GOOGLE_PLACES_API_KEY=
